# PostgreSQL connection, must use the asyncpg driver (nested group syntax)
DATABASE__URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/qiankun

# JWT signing secret, minimum 32 characters, must be changed in production
JWT__SECRET=change-this-secret-at-least-32-characters-long
# Access token lifetime in minutes
JWT__ACCESS_TOKEN_MINUTES=30
# Refresh token lifetime in days
JWT__REFRESH_TOKEN_DAYS=30

# Scheduler nested settings, first-boot seed only; afterwards managed in system_settings
SCHEDULER__INTERVAL_SECONDS=5
SCHEDULER__MAX_CONCURRENT_TASKS=10

# Runtime nested settings, first-boot seed only; afterwards managed in system_settings
RUNTIME__DEFAULT_TIMEOUT=300
RUNTIME__CLEANUP_TIMEOUT=30

# Logging nested settings, first-boot seed only; PUT /system-settings/logging/loguru
# hot-reloads sinks without restart
LOGGING__LEVEL=INFO
LOGGING__ROTATION=100 MB
LOGGING__RETENTION=30 days
LOGGING__DIRECTORY=logs

# CORS origins separated by commas, empty means same origin only
CORS_ORIGINS=

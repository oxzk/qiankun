APP_NAME=QianKun
# 生产环境必须设置 APP_DEBUG=false, 并配置强随机 JWT_SECRET_KEY
APP_DEBUG=true
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/qiankun
DATABASE_SSL_ENABLED=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
JWT_SECRET_KEY=dev-only-change-me
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_DELAY_SECONDS=0.5
HTTP_RETRY_BACKOFF=2.0
SCHEDULER_INTERVAL_SECONDS=5
SCHEDULER_MAX_CONCURRENT_TASKS=10
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PROVIDER_CODE_SANDBOX=true
